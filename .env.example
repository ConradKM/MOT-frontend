# Cloudflare Turnstile for the public booking wizard. The widget renders on
# Step 3 (Review); its token is sent with the booking request and verified
# server-side before anything is created (recaptcha / hcaptcha also supported).
#
# For local dev, copy these into .env.local (gitignored) — they are
# Cloudflare's published TEST keys and pair with the backend test secret
# (CAPTCHA_PROVIDER=turnstile). Production uses real keys from the Cloudflare
# dashboard. https://developers.cloudflare.com/turnstile/troubleshooting/testing/
VITE_CAPTCHA_PROVIDER=turnstile
VITE_CAPTCHA_SITE_KEY=1x00000000000000000000AA

# Leaving these unset disables the widget (token is empty); only use that with
# a backend running CAPTCHA_PROVIDER=none (tests / offline work).
